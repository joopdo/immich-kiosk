package partials

import (
	"fmt"
	"github.com/damongolding/immich-kiosk/internal/nowplaying"
	"time"
)

// NowPlayingContainer polls /now-playing. No client-side timers or animation: the
// server renders a finished snapshot every interval seconds.
templ NowPlayingContainer(interval int) {
	<section
		id="now-playing"
		hx-post="/now-playing"
		hx-trigger={ fmt.Sprintf("load, every %ds", interval) }
		hx-swap="innerHTML"
		aria-live="off"
	></section>
}

func nowPlayingEndsAt(t time.Time, timeFormat string, loc *time.Location) string {
	if loc != nil {
		t = t.In(loc)
	}
	if timeFormat == "12" {
		return t.Format("3:04 PM")
	}
	return t.Format("15:04")
}

func nowPlayingBarWidth(info *nowplaying.Info) string {
	return fmt.Sprintf("width:%.1f%%", info.Progress())
}

templ nowPlayingIcon(paused bool) {
	if paused {
		<svg class="now-playing--icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path></svg>
	} else {
		<svg class="now-playing--icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l10.6-6.8a.8.8 0 0 0 0-1.4L9.2 4.5A.8.8 0 0 0 8 5.2z"></path></svg>
	}
}

// NowPlaying renders one snapshot; nil renders nothing.
templ NowPlaying(info *nowplaying.Info, timeFormat string, loc *time.Location) {
	if info != nil {
		<div class={ "now-playing", templ.KV("now-playing--paused", info.Paused()) }>
			<div class="now-playing--title">
				@nowPlayingIcon(info.Paused())
				<span>{ info.Title }</span>
			</div>
			if info.Subtitle != "" {
				<div class="now-playing--subtitle">{ info.Subtitle }</div>
			}
			if info.Duration > 0 {
				<div class="now-playing--bar"><div class="now-playing--bar-fill" style={ nowPlayingBarWidth(info) }></div></div>
				<div class="now-playing--times">
					<span>{ nowplaying.FormatDuration(info.Position) } / { nowplaying.FormatDuration(info.Duration) }</span>
					<span class="now-playing--ends">
						<svg class="now-playing--icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm-1 3v5.4l4.3 2.6 1-1.7-3.3-2V7z"></path></svg>
						{ nowPlayingEndsAt(info.EndsAt, timeFormat, loc) }
					</span>
				</div>
			}
		</div>
	}
}
